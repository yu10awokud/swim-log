# このファイルをコピーして「.env.local」という名前で保存し、値を書き換えてください。
# .env.local は .gitignore 済みなので GitHub には上がりません。
#
# 値の場所：Supabase ダッシュボード → Project Settings → Data API / API Keys

# Project URL（例：https://abcdefghijklmnop.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Publishable key（sb_publishable_... で始まるもの。旧形式の anon public キーでも可）
# ブラウザで画像を送るときだけ使います。これだけではデータは読めません。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key（sb_secret_... で始まるもの。旧形式の service_role キーでも可）
# サーバーだけで使います。名前を「NEXT_PUBLIC_」で始めないこと（ブラウザに漏れてしまいます）。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
